{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "client_token",
    "expires_at",
    "device_id",
    "keywords"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "client_token": {
      "type": "string",
      "x-secret": true,
      "x-host-only": true,
      "pattern": "^clt\\.[A-Za-z0-9_-]{1,512}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "x-host-only": true
    },
    "device_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "x-host-only": true
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 50
    },
    "follow_public_videos": {
      "type": "boolean",
      "default": false,
      "description": "允许按已授权搜索结果核对公开作品的官方播放器入口"
    },
    "sample_public_playback": {
      "type": "boolean",
      "default": false,
      "description": "另行允许从已授权播放器入口开始静音采样"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "sample_public_playback"
        ],
        "properties": {
          "sample_public_playback": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "follow_public_videos"
        ],
        "properties": {
          "follow_public_videos": {
            "const": true
          }
        }
      }
    }
  ]
}
