{
  "version": 1,
  "capabilities": [
    {
      "id": "observation.web-page-text",
      "implementation": "ready",
      "description": "由 Windows 宿主在主人单独开启后读取首页实际可见文字；主人扩大范围后，可读取从首页实际发现的视频页面文字",
      "permissions": [],
      "discoverable": true,
      "requires_owner_setting": "explicit-owner-web-read"
    },
    {
      "id": "observation.web-playback",
      "implementation": "ready",
      "description": "由 Windows 宿主在主人独立允许后，静音采样首页实际发现并核验的视频页主媒体，只记录实际播放区间",
      "permissions": [],
      "discoverable": true,
      "requires_owner_setting": "web-sample-playback"
    },
    {
      "id": "observation.web-audio",
      "implementation": "ready",
      "description": "由 Windows 宿主在主人独立允许后取得确切视频原件，经本机 FFmpeg 和已启用的本机语音识别按窗口转写，不表示画面已理解或视频已看完",
      "permissions": [],
      "discoverable": true,
      "requires_owner_setting": "web-transcribe-audio"
    },
    {
      "id": "observation.web-visual",
      "implementation": "ready",
      "description": "由 Windows 宿主在主人独立允许后，从已核对的确切视频原件按批解码 1–12 帧并交给已启用的媒体理解工具；返回媒体摘要、实际 PTS 和可继续位置，不表示完整观看",
      "permissions": [],
      "discoverable": true,
      "requires_owner_setting": "web-inspect-visual"
    },
    {
      "id": "publication.web-creator",
      "implementation": "ready",
      "description": "由 Windows 宿主在主人明确保存网页登录资料并单独开启发布许可后，通过创作者中心上传已核验的作品；提交前持久登记，重启后只查询回执，不会自动重复发布",
      "permissions": [],
      "discoverable": true,
      "requires_owner_setting": "explicit-owner-web-publish"
    }
  ]
}
