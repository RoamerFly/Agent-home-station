{
  "version": 1,
  "kind": "station-official-douyin-app",
  "host_entrypoint": "douyin-search",
  "connection": "search",
  "connection_authority": "host",
  "authentication": "host-only-app-client-token",
  "scope": "aweme.dy.video_search",
  "observation_fields": [
    "search",
    "own_video",
    "player_entry",
    "playback",
    "account_works",
    "page_text"
  ],
  "web_read": {
    "connection": "web-page-text",
    "authentication": "host-owned-saved-web-login",
    "content": "home",
    "video_content_prefix": "web-video-",
    "field": "page_text",
    "owner_opt_in": "explicit-owner-web-read",
    "expanded_scope_owner_opt_in": "web-scope-home-and-videos",
    "scope_default": "home",
    "scope_expanded": "home_and_videos",
    "playback": {
      "field": "playback",
      "owner_opt_in": "web-sample-playback",
      "source": "host-verified-home-video-link-and-main-media",
      "evidence": "html-media-played-ranges",
      "default_seconds": 6,
      "min_seconds": 1,
      "max_seconds": 20
    },
    "pagination": "host-owned",
    "profile": "host-owned"
  },
  "own_video": {
    "connection": "own-videos",
    "authentication": "host-only-user-access-token",
    "scope": "posting.behavior",
    "method": "POST",
    "config": "own-video.schema.json"
  },
  "account": {
    "connection": "authorized-account",
    "authentication": "host-only-user-oauth",
    "scope": "user_info",
    "owner_action": "web-authorization",
    "works": {
      "scope": "video.list.bind",
      "method": "GET",
      "owner_opt_in": "read_works",
      "page_limit_per_scan": 4,
      "verification": "provider-scope-required"
    }
  },
  "player_entry": {
    "connection": "search",
    "authentication": "anonymous",
    "source": "verified-search-result",
    "owner_setting": "follow_public_videos"
  },
  "playback": {
    "connection": "search",
    "source": "verified-official-player",
    "owner_setting": "sample_public_playback",
    "evidence": "html-media-played-ranges"
  },
  "publication": {
    "connection": "authorized-account",
    "authentication": "host-only-user-oauth",
    "scopes": [
      "video.create.bind",
      "posting.behavior"
    ],
    "owner_opt_in": "publish_video",
    "media": [
      "mp4",
      "webm"
    ],
    "checkpointed": true
  }
}
