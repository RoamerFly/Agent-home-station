{
  "version": 1,
  "name": "大肥鱼的消息与行动",
  "nodes": [
    {
      "id": "receive",
      "kind": "receive",
      "title": "微信接入",
      "note": "接收群聊、好友私信和文件传输助手消息。",
      "tone": "blue",
      "x": 0,
      "y": 240
    },
    {
      "id": "inbox",
      "kind": "inbox",
      "title": "接收与去重",
      "note": "先保存接收状态，再推进事件游标；重启后恢复未处理消息。",
      "tone": "blue",
      "x": 248,
      "y": 240
    },
    {
      "id": "rules",
      "kind": "rules",
      "title": "会话与权限",
      "note": "检查群聊和好友授权、安静时段、消息方向与真正的@。",
      "tone": "blue",
      "x": 496,
      "y": 240
    },
    {
      "id": "observe",
      "kind": "observe",
      "title": "媒体理解",
      "note": "读取图片、表情、语音、视频及分享卡片；失败也交给Agent决定下一步。",
      "tone": "teal",
      "x": 992,
      "y": 240
    },
    {
      "id": "memory",
      "kind": "memory",
      "title": "上下文与记忆",
      "note": "读取会话摘要、近期消息、关系备注、引用素材和项目文档索引。",
      "tone": "teal",
      "x": 1240,
      "y": 240
    },
    {
      "id": "agent",
      "kind": "agent",
      "title": "Agent决策",
      "note": "模型结合当前请求，决定回复、使用工具、等待或选择安静。",
      "tone": "violet",
      "x": 1488,
      "y": 240
    },
    {
      "id": "status",
      "kind": "status",
      "title": "运行与费用",
      "note": "检查账号连接、Agent运行状态、Token消耗和服务商余额。",
      "tone": "slate",
      "x": 0,
      "y": 0
    },
    {
      "id": "quote",
      "kind": "quote",
      "title": "引用与正文",
      "note": "区分用户的引用回复与新分享，关联本会话真实原消息和素材。",
      "tone": "blue",
      "x": 496,
      "y": 420
    },
    {
      "id": "aggregate",
      "kind": "aggregate",
      "title": "聚合与补充",
      "note": "合并同一人的紧邻说明，在任务执行期间接收补充和更改。",
      "tone": "teal",
      "x": 744,
      "y": 240
    },
    {
      "id": "persona",
      "kind": "persona",
      "title": "角色与关系",
      "note": "设置鲸鱼娘的身份、表达习惯、相处方式与群聊补充设定。",
      "tone": "violet",
      "x": 992,
      "y": 0
    },
    {
      "id": "model",
      "kind": "model",
      "title": "模型与语音",
      "note": "配置语言、图片理解、语音识别和合成服务商。",
      "tone": "violet",
      "x": 1240,
      "y": 0
    },
    {
      "id": "tasks",
      "kind": "tasks",
      "title": "异步任务续办",
      "note": "保存音乐生成、后台进程、提醒等任务的进度，完成后回到原会话。",
      "tone": "amber",
      "x": 1984,
      "y": 240
    },
    {
      "id": "archive",
      "kind": "archive",
      "title": "投递记忆",
      "note": "根据实际发送状态记录文本和媒体来源，不能把发送尝试当作成功。",
      "tone": "teal",
      "x": 744,
      "y": 620
    },
    {
      "id": "receipt",
      "kind": "receipt",
      "title": "回执核对",
      "note": "区分已接受、未确认和已观察到；服务端接受不等于手机已播放。",
      "tone": "teal",
      "x": 992,
      "y": 620
    },
    {
      "id": "send",
      "kind": "send",
      "title": "动态排队发送",
      "note": "逐条发送文本、图片、语音、视频或文件，统一动态间隔并保留取消能力。",
      "tone": "blue",
      "x": 1240,
      "y": 620
    },
    {
      "id": "plan",
      "kind": "plan",
      "title": "回复计划",
      "note": "按语义组织文字与媒体，后续新消息可以修改尚未发送的部分。",
      "tone": "violet",
      "x": 1488,
      "y": 620
    },
    {
      "id": "feedback",
      "kind": "feedback",
      "title": "工具结果反馈",
      "note": "把实际执行结果、失败原因和继续位置交回模型，决定继续、重试或换方法。",
      "tone": "amber",
      "x": 1736,
      "y": 420
    },
    {
      "id": "tools",
      "kind": "tools",
      "title": "工具与工具",
      "note": "按需发现MCP、联网、媒体、YuE、提醒及已授权的项目和服务器工具。",
      "tone": "amber",
      "x": 1736,
      "y": 240
    },
    {
      "id": "permissions",
      "kind": "permissions",
      "title": "能力权限",
      "note": "集中管理发送媒体、主动行为及主人的高权限范围。",
      "tone": "slate",
      "x": 248,
      "y": 0
    },
    {
      "id": "retry",
      "kind": "retry",
      "title": "恢复与补发",
      "note": "核对聊天和发送记录；按实际证据与随机退避继续补发，避免重复已确认内容。",
      "tone": "rose",
      "x": 992,
      "y": 820
    },
    {
      "id": "interrupt",
      "kind": "interrupt",
      "title": "中断与变更",
      "note": "识别叫停、换文件、换作品等新需求，只取消尚未执行或发送的旧内容。",
      "tone": "rose",
      "x": 496,
      "y": 620
    },
    {
      "id": "silent",
      "kind": "silent",
      "title": "选择安静",
      "note": "本轮不发言，也可以安排未来再评估；沉默不耗尽后续机会。",
      "tone": "slate",
      "x": 1736,
      "y": 620
    },
    {
      "id": "wake",
      "kind": "wake",
      "title": "自主复评",
      "note": "持久保存后续计划，到期结合新上下文自然接话、探索或安静。",
      "tone": "violet",
      "x": 1984,
      "y": 620
    },
    {
      "id": "surf",
      "kind": "surf",
      "title": "网上冲浪",
      "note": "从多来源发现并核实音乐、图片、视频和生活内容，按目标授权决定是否分享。",
      "tone": "amber",
      "x": 1984,
      "y": 820
    }
  ],
