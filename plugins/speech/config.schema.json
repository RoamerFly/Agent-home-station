{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tts_endpoint": {
      "type": "string",
      "title": "云端语音接口地址",
      "description": "完整 HTTPS SpeechSynthesizer 地址；仅宿主会向此固定接口发送密钥。"
    },
    "tts_key": {
      "type": "string",
      "title": "云端语音接口密钥",
      "x-secret": true,
      "x-host-only": true
    },
    "tts_model": {
      "type": "string",
      "title": "语音模型",
      "minLength": 1,
      "maxLength": 128
    },
    "default_voice": {
      "type": "string",
      "title": "默认说话声线",
      "minLength": 1,
      "maxLength": 128
    },
    "default_instruction": {
      "type": "string",
      "title": "默认表达要求",
      "maxLength": 1500
    }
  },
  "required": [
    "tts_endpoint",
    "tts_key",
    "tts_model",
    "default_voice"
  ],
  "additionalProperties": false
}
