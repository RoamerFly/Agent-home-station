{
  "version": 1,
  "capabilities": [
    {
      "id": "speech.synthesize",
      "implementation": "ready",
      "description": "通过宿主绑定的云端接口合成默认说话声线；宿主核验音频并负责素材登记与微信投递。",
      "permissions": [
        "model.invoke"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "instruction": {
            "type": "string",
            "maxLength": 1500
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true
    },
    {
      "id": "speech.voices",
      "implementation": "migration-pending",
      "description": "声线查询、克隆与设计的未来占位能力；尚未迁移，不请求运行时权限或访问声线资料。",
      "permissions": [],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": false
    },
    {
      "id": "speech.train",
      "implementation": "migration-pending",
      "description": "本地声线训练的未来占位能力；尚未迁移，不请求 GPU、网络、素材或工作区权限。",
      "permissions": [],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": false
    }
  ]
}
