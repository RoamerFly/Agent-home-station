package admin

import (
	"context"
	"encoding/binary"
	"encoding/json"
	"os"
	"path/filepath"
	"testing"
	"time"
	"wechat-bot/internal/mcptools"
	bailian "wechat-bot/plugins/speech/dev/legacy-sdk"
)

func TestLiveBailianWhaleVoiceCandidates(t *testing.T) {
	root, workspace := os.Getenv("WECHAT_LIVE_MEDIA_ROOT"), os.Getenv("WECHAT_LIVE_WORKSPACE")
	if root == "" || workspace == "" || os.Getenv("WECHAT_VOICE_DESIGN_LIVE") != "1" {
		t.Skip("explicit owner-requested voice design; does not select or send a voice")
	}
	// Do this before any paid design/inspection request. The audition must not
	// create a candidate when the official isolated speech route is unavailable.
	_ = requireLiveSpeechPluginRuntime(t)
	cfg, err := loadSpeech(filepath.Join(root, "admin"))
	if err != nil {
		t.Fatal(err)
	}
	var spec struct {
		Model      string `json:"target_model"`
		Preview    string `json:"preview_text"`
		Candidates []struct {
			Code, Name, Prefix string
			Prompt             string `json:"voice_prompt"`
		} `json:"candidates"`
	}
	b, err := os.ReadFile(filepath.Join(workspace, "design/voice/bluewhale-candidates.json"))
	if err != nil || json.Unmarshal(b, &spec) != nil {
		t.Fatal("candidate specification unavailable", err)
	}
	cfg.TTSModel = spec.Model
	client := bailian.New(cfg)
	output := filepath.Join(workspace, "research/evidence/voice-design-bailian")
	if err = os.MkdirAll(output, 0700); err != nil {
		t.Fatal(err)
	}
	ledger := filepath.Join(workspace, "secrets/bluewhale-voice-design.json")
	entries := map[string]map[string]any{}
	if b, err = os.ReadFile(ledger); err == nil {
		if json.Unmarshal(b, &entries) != nil {
			t.Fatal("private voice registry invalid")
		}
	} else if !os.IsNotExist(err) {
		t.Fatal(err)
	}
	save := func() {
		t.Helper()
		b, err := json.MarshalIndent(entries, "", "  ")
		if err != nil {
			t.Fatal(err)
		}
		if err = writePrivate(ledger, b); err != nil {
			t.Fatal(err)
		}
	}
	for _, candidate := range spec.Candidates {
		var voice bailian.DesignedVoice
		var entry map[string]any
		if old, ok := entries[candidate.Code]; ok {
			if old["state"] == "ready" && old["preview_kind"] == "tts_wav" {
				t.Log("reuse existing candidate", candidate.Code)
				continue
			}
			id, _ := old["voice_id"].(string)
			if id == "" {
				t.Fatal("previous create needs inspection; refusing duplicate", candidate.Code, old["state"])
			}
			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
			voice, err = client.InspectDesignedVoice(ctx, id)
			cancel()
			if err != nil {
				t.Fatal("existing voice not ready", candidate.Code, err)
			}
			entry = old
		}
		if entry == nil {
			entry = map[string]any{"name": candidate.Name, "prefix": candidate.Prefix, "target_model": spec.Model, "prompt": candidate.Prompt, "preview_text": spec.Preview, "created_at": time.Now().UTC().Format(time.RFC3339), "state": "creating"}
			entries[candidate.Code] = entry
			save()
			ctx, cancel := context.WithTimeout(context.Background(), 180*time.Second)
			voice, err = client.DesignVoice(ctx, candidate.Prefix, candidate.Prompt, spec.Preview)
			cancel()
			entry["voice_id"], entry["state"] = voice.ID, "needs_review"
			save()
			if err != nil {
				entry["error"] = err.Error()
				save()
				t.Fatal("voice design did not finish; no automatic retry", candidate.Code, err)
			}
		}
		// The design resource can be raw PCM without reliable format metadata.
		// Use the normal TTS WAV contract for all comparable audition clips.
		reuse := cfg
		reuse.Voice = voice.ID
		ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
		url, err := livePluginSynthesize(t, ctx, reuse, spec.Preview, "保持该音色的自然特点，亲切轻松，正常语速，不唱歌。")
		if err == nil {
			voice.Preview, _, err = mcptools.GetPublicMedia(ctx, url, 8<<20)
		}
		cancel()
		if err != nil {
			t.Fatal("existing voice audition synthesis failed", candidate.Code, err)
		}
		if len(voice.Preview) < 44 || string(voice.Preview[:4]) != "RIFF" || string(voice.Preview[8:12]) != "WAVE" {
			t.Fatal("audition response is not WAV", candidate.Code)
		}
		// Bailian emits a streaming WAV header with placeholder lengths even
		// after the HTTP body finishes. Finalize only its known PCM layout.
		if string(voice.Preview[12:16]) == "fmt " && binary.LittleEndian.Uint32(voice.Preview[16:20]) == 16 && string(voice.Preview[36:40]) == "data" && binary.LittleEndian.Uint32(voice.Preview[40:44]) == 0x7fffff9b {
			if (len(voice.Preview)-44)%2 != 0 {
				t.Fatal("incomplete PCM sample", candidate.Code)
			}
			binary.LittleEndian.PutUint32(voice.Preview[4:8], uint32(len(voice.Preview)-8))
			binary.LittleEndian.PutUint32(voice.Preview[40:44], uint32(len(voice.Preview)-44))
		}
		filename := candidate.Code + "-" + candidate.Name + ".wav"
		if err = os.WriteFile(filepath.Join(output, filename), voice.Preview, 0600); err != nil {
			t.Fatal(err)
		}
		entry["preview_path"], entry["preview_bytes"], entry["state"] = filepath.Join(output, filename), len(voice.Preview), "created"
		entry["preview_kind"] = "tts_wav"
		save()
		// Confirm the returned voice can be reused with its bound TTS model.
		ctx, cancel = context.WithTimeout(context.Background(), 90*time.Second)
		url, err = livePluginSynthesize(t, ctx, reuse, "今天也陪你聊点有趣的，等你选好，我就用这个声音和你打招呼。", "保持该音色的自然特点，亲切轻松，正常语速，不唱歌。")
		if err == nil {
			var audio []byte
			audio, _, err = mcptools.GetPublicMedia(ctx, url, 8<<20)
			if err == nil {
				err = os.WriteFile(filepath.Join(output, candidate.Code+"-复用验证.wav"), audio, 0600)
			}
		}
		cancel()
		if err != nil {
			entry["reuse_error"] = err.Error()
			save()
			t.Fatal("voice exists but synthesis reuse not verified", candidate.Code, err)
		}
		entry["state"], entry["reuse_verified"] = "ready", true
		delete(entry, "error")
		delete(entry, "reuse_error")
		save()
		t.Log("candidate ready", candidate.Code, candidate.Name, len(voice.Preview))
	}
	report, _ := json.MarshalIndent(map[string]any{"provider": "阿里云百炼", "target_model": spec.Model, "candidates": entries, "wechat_sends": 0, "active_voice_changed": false, "singing_voice_conversion": false}, "", "  ")
	if err = os.WriteFile(filepath.Join(output, "catalog.json"), report, 0600); err != nil {
		t.Fatal(err)
	}
}
