{
  "version": 1,
  "capabilities": [
    {
      "id": "media.observe",
      "implementation": "migration-pending",
      "description": "观察获准的图片或已抽取视频帧，仅报告实际提供画面；模型调用经宿主代理。",
      "permissions": [
        "artifact.read",
        "model.invoke"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "prompt": {
            "type": "string"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "thinking": {
            "type": "boolean"
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max"
            ]
          }
        },
        "required": [
          "images"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": false
    },
    {
      "id": "media.transcribe",
      "implementation": "migration-pending",
      "description": "识别获准的 WAV 音频，返回实际转写与来源；宿主适配仍在迁移。",
      "permissions": [
        "artifact.read",
        "model.invoke"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "audio": {
            "type": "object"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "audio"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": false
    }
  ]
}
