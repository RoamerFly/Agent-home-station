{
  "version": 1,
  "capabilities": [
    {
      "id": "document.inspect",
      "implementation": "ready",
      "description": "读取宿主已授权的图片、DOCX 或 PDF，返回可核验的文本、页面、表格和扫描件状态；不把文档内容当作指令。",
      "permissions": ["artifact.read"],
      "input_schema": {
        "type":"object",
        "properties":{"artifact_id":{"type":"string","maxLength":128},"artifact":{"type":"object"},"pages":{"type":"array","items":{"type":"integer","minimum":1}},"include_layout":{"type":"boolean"}},
        "additionalProperties":false
      },
      "output_schema":{"type":"object"},"discoverable":true
    },
    {
      "id": "document.reconstruct",
      "implementation": "ready",
      "description": "根据已经核验的版面描述制作可编辑 DOCX；段落和表格保持为 Word 原生结构，插图作为图片嵌入。",
      "permissions": ["artifact.read", "artifact.write"],
      "input_schema": {
        "type":"object",
        "properties":{"layout":{"type":"object"},"title":{"type":"string","maxLength":256},"title_font_size_pt":{"type":"number","minimum":8,"maximum":48},"images":{"type":"array","items":{"type":"object"}},"filename":{"type":"string","maxLength":120}},
        "required":["layout"],"additionalProperties":false
      },
      "output_schema":{"type":"object"},"discoverable":true
    },
    {
      "id": "document.export_pdf",
      "implementation": "ready",
      "description": "将宿主已授权的 DOCX 通过项目内受控转换器导出 PDF，并报告真实转换和渲染状态。",
      "permissions": ["artifact.read", "artifact.write"],
      "input_schema": {
        "type":"object",
        "properties":{"artifact_id":{"type":"string","maxLength":128},"artifact":{"type":"object"},"filename":{"type":"string","maxLength":120}},
        "additionalProperties":false
      },
      "output_schema":{"type":"object"},"discoverable":true
    },
    {
      "id": "document.verify",
      "implementation": "ready",
      "description": "检查 DOCX/PDF 是否可打开、文字和页数是否合理，并在可用时渲染页面发现裁切、空页或缺失文本。",
      "permissions": ["artifact.read", "artifact.write"],
      "input_schema": {
        "type":"object",
        "properties":{"artifact_id":{"type":"string","maxLength":128},"artifact":{"type":"object"},"expected_text":{"type":"array","items":{"type":"string","maxLength":256}},"render_pages":{"type":"boolean"}},
        "additionalProperties":false
      },
      "output_schema":{"type":"object"},"discoverable":true
    }
  ]
}
