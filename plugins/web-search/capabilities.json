{
  "version": 1,
  "capabilities": [
    {
      "id": "web.search",
      "implementation": "ready",
      "description": "按配置搜索公共索引或 DeepSeek 官方检索；默认请求6个候选，可指定候选数与返回页大小。请求参数不会被静默压缩，也不会自动切换后端。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    },
    {
      "id": "web.read",
      "implementation": "ready",
      "description": "读取公共网页正文，默认10000字符，可分页并校验内容哈希。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "expected_sha256": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    }
  ]
}
