{
  "version": 1,
  "capabilities": [
    {
      "id": "web.search",
      "implementation": "ready",
      "description": "搜索公开网页或 B 站作品。count、offset、limit 可调；source=bilibili 时优先查 B 站，必要时续查公开索引。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["bilibili"],
            "description": "选择 bilibili 可直接按作品或歌手搜索 B 站视频。省略时使用配置的通用搜索后端。"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    },
    {
      "id": "web.read",
      "implementation": "ready",
      "description": "读取公开网页正文，按 offset/limit 续读；read_coverage.page_body 返回实际覆盖范围。音视频下载用 web_media_download。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "expected_sha256": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    },
    {
      "id": "web.discover",
      "implementation": "ready",
      "description": "发现已授权的订阅、社区、图片或音频目录候选；用 offset/limit 续页。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "type": "string",
                "enum": [
                  "rss",
                  "bilibili",
                  "bing_images",
                  "audio_catalog"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "voice",
                  "image",
                  "video"
                ]
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "url",
              "kind",
              "enabled"
            ],
            "additionalProperties": false
          },
          "related_url": {
            "type": "string",
            "maxLength": 2048
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    }
  ]
}
