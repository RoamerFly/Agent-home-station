{
  "version": 1,
  "capabilities": [
    {
      "id": "web.search",
      "implementation": "ready",
      "description": "按配置搜索公共索引或 DeepSeek 官方检索；默认请求6个候选，可指定候选数与返回页大小。请求参数不会被静默压缩，也不会自动切换后端。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["bilibili"],
            "description": "选择 bilibili 可直接按作品或歌手搜索 B 站视频。省略时使用配置的通用搜索后端。"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    },
    {
      "id": "web.read",
      "implementation": "ready",
      "description": "读取公共网页正文，默认10000字符，可分页并校验内容哈希。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "expected_sha256": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    },
    {
      "id": "web.discover",
      "implementation": "ready",
      "description": "读取宿主已授权的公开订阅、社区、图片或音频目录并解析候选元数据；不代表观看、播放或发送。默认每页40条，可指定offset/limit继续。",
      "permissions": [
        "network"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "type": "string",
                "enum": [
                  "rss",
                  "bilibili",
                  "bing_images",
                  "audio_catalog"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "voice",
                  "image",
                  "video"
                ]
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "url",
              "kind",
              "enabled"
            ],
            "additionalProperties": false
          },
          "related_url": {
            "type": "string",
            "maxLength": 2048
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "discoverable": true,
      "side_effect": "read"
    }
  ]
}
