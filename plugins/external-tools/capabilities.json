      "id":"external.mcp_request","implementation":"ready","discoverable":true,"side_effect":"read","permissions":["network"],"description":"固定外部 MCP 目录页或单次调用；宿主连接、来源和媒体引用保持权威校验。","input_schema":{"type":"object","properties":{},"additionalProperties":false},"output_schema":{"type":"object"}
