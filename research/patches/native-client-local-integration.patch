+            || {
+                attempts += 1;
+                Err(std::io::Error::from(std::io::ErrorKind::ConnectionReset).into())
+            },
+            || waits += 1,
+        );
+        assert!(result.is_err());
+        assert_eq!(attempts, 3);
+        assert_eq!(waits, 2);
+        let mut attempts = 0;
+        let result = retry_voice_handshake::<()>(
+            || {
+                attempts += 1;
+                bail!("Rejected authentication")
+            },
+            || panic!("rejected handshakes must not retry"),
+        );
+        assert!(result.is_err());
+        assert_eq!(attempts, 1);
+        let mut attempts = 0;
+        assert_eq!(
+            retry_voice_handshake(
+                || {
+                    attempts += 1;
+                    if attempts == 1 {
+                        bail!("MMTLS connection closed");
+                    }
+                    Ok(42)
+                },
+                || {}
+            )
+            .unwrap(),
+            42
+        );
+    }
