+#[cfg(test)]
+mod voice_handshake_tests {
+    use super::*;
+    #[test]
+    fn only_uncommitted_prefix_retries_and_final_submission_never_repeats() {
+        for (final_range, expected) in [(false, 3), (true, 1)] {
+            let mut attempts = 0;
+            let mut waits = 0;
+            let result = retry_voice_prefix::<()>(
+                final_range,
+                |_| {
+                    attempts += 1;
+                    Err(std::io::Error::from(std::io::ErrorKind::TimedOut).into())
+                },
+                |_| {
+                    waits += 1;
+                    Ok(())
+                },
+            );
+            assert!(result.is_err());
+            assert_eq!(attempts, expected);
+            assert_eq!(waits, expected - 1);
+        }
+        let mut attempts = 0;
+        let result = retry_voice_prefix::<()>(
+            false,
+            |_| {
+                attempts += 1;
+                bail!("Rejected authentication");
+            },
+            |_| panic!("service rejection must stop"),
+        );
+        assert!(result.is_err());
+        assert_eq!(attempts, 1);
+        let result = retry_voice_prefix::<()>(
+            false,
+            |_| Err(std::io::Error::from(std::io::ErrorKind::TimedOut).into()),
+            |_| bail!("media_cancelled"),
+        );
+        assert!(result.unwrap_err().to_string().contains("media_cancelled"));
+    }
+    #[test]
+    fn retries_only_pre_submission_transport_failures_and_stops_at_three() {
+        let mut attempts = 0;
+        let mut waits = 0;
+        let result = retry_voice_handshake::<()>(
+            || {
+                attempts += 1;
+                Err(std::io::Error::from(std::io::ErrorKind::ConnectionReset).into())
+            },
+            || waits += 1,
+        );
+        assert!(result.is_err());
+        assert_eq!(attempts, 3);
+        assert_eq!(waits, 2);
+        let mut attempts = 0;
+        let result = retry_voice_handshake::<()>(
+            || {
+                attempts += 1;
+                bail!("Rejected authentication")
+            },
+            || panic!("rejected handshakes must not retry"),
+        );
+        assert!(result.is_err());
+        assert_eq!(attempts, 1);
+        let mut attempts = 0;
+        assert_eq!(
+            retry_voice_handshake(
+                || {
+                    attempts += 1;
+                    if attempts == 1 {
+                        bail!("MMTLS connection closed");
+                    }
+                    Ok(42)
+                },
+                || {}
+            )
+            .unwrap(),
+            42
+        );
+    }
