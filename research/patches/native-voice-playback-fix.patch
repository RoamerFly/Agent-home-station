+fn retry_voice_prefix<T>(
+    is_final: bool,
+    mut exchange: impl FnMut(u32) -> Result<T>,
+    mut wait: impl FnMut(u32) -> Result<()>,
+) -> Result<T> {
+    for attempt in 0..3 {
+        match exchange(attempt) {
+            Ok(result) => return Ok(result),
+            Err(error) if !is_final && attempt < 2 && is_retryable_login_poll_error(&error) => {
+                wait(attempt + 1)?
+            }
+            Err(error) => return Err(error),
+        }
+    }
+    unreachable!()
+}
+
+fn voice_transport_kind(error: &anyhow::Error) -> &'static str {
+    for cause in error.chain() {
+        if let Some(http) = cause.downcast_ref::<reqwest::Error>() {
+            if http.is_timeout() {
+                return "voice_transport_timeout";
+            }
+            if http.is_connect() {
+                return "voice_transport_connect";
+            }
+            if http.is_body() {
+                return "voice_transport_body";
+            }
+        }
+        if let Some(io) = cause.downcast_ref::<std::io::Error>() {
+            return match io.kind() {
+                std::io::ErrorKind::TimedOut | std::io::ErrorKind::WouldBlock => {
+                    "voice_transport_timeout"
+                }
+                std::io::ErrorKind::ConnectionReset
+                | std::io::ErrorKind::ConnectionAborted
+                | std::io::ErrorKind::BrokenPipe
+                | std::io::ErrorKind::UnexpectedEof => "voice_transport_closed",
+                _ => "voice_transport_io",
+            };
+        }
+    }
+    "voice_transport_unclassified"
+}
+
+fn retry_voice_handshake<T>(
+    mut connect: impl FnMut() -> Result<T>,
+    mut wait: impl FnMut(),
+) -> Result<T> {
+    for attempt in 0..3 {
+        match connect() {
+            Ok(session) => return Ok(session),
+            Err(error) if attempt < 2 && is_retryable_login_poll_error(&error) => wait(),
+            Err(error) => return Err(error),
+        }
+    }
+    unreachable!()
+}
